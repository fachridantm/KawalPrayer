    "Aplikasi pengingat waktu sholat dan adzan menu bar untuk macOS.\nBekerja senyap di background tanpa mengganggu dock.\nDilengkapi Al-Quran offline, arah kiblat, doa setelah adzan, dan pengaman waktu Kemenag RI.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi pengingat waktu sholat dan adzan menu bar untuk macOS.\nBekerja senyap di background tanpa mengganggu dock.\nDilengkapi Al-Quran offline, arah kiblat, doa setelah adzan, dan pengaman waktu Kemenag RI."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu bar prayer times & adzan app for macOS.\nRuns quietly in the background without cluttering the Dock.\nEquipped with offline Quran, Qibla direction, Dua after Adzan, and safety margin adjustments."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق تنبيه مواقيت الصلاة والأذان لشريط القوائم على نظام macOS.\nيعمل في الخلفية بدون الظهور في Dock.\nمزوّد بالقرآن الكريم بدون إنترنت، واتجاه القبلة، والدعاء بعد الأذان، وضوابط مواقيت الصلاة."
          }
        }
      }
    },
    "Aplikasi perlu di-restart agar perubahan bahasa diterapkan. Restart sekarang?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب إعادة تشغيل التطبيق لتطبيق تغيير اللغة. هل تريد إعادة التشغيل الآن؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app needs to restart to apply the language change. Restart now?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi perlu di-restart agar perubahan bahasa diterapkan. Restart sekarang?"
          }
        }
      }
    },
